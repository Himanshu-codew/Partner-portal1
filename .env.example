# Environment variables (.env.example)

# IMPORTANT: Do NOT commit real secrets. Replace placeholders only.
# This file lists every environment variable read by the codebase (verified from source).
# Required in production are marked below.

# Django core
# DJANGO_SECRET_KEY (or SECRET_KEY): required in production (DEBUG False). If missing and DEBUG False, ImproperlyConfigured.
# DJANGO_DEBUG: override DEBUG; "true/1/yes/t" enables. Defaults: DEBUG=False when RENDER present, else True.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
SECRET_KEY=
DJANGO_DEBUG=False

# Hosts / CSRF
# ALLOWED_HOSTS: comma-separated hostnames. Render adds RENDER_EXTERNAL_HOSTNAME automatically.
ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS: comma-separated origins (https://...)
CSRF_TRUSTED_ORIGINS=

# Render (deployment)
# RENDER: set to true by Render; used to set DEBUG=False and to derive SITE_URL/hosts if needed.
RENDER=

# Database
# DATABASE_URL: PostgreSQL URL (Neon/Render). If absent, SQLite (db.sqlite3) is used locally.
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=
# DB_DISABLE_SERVER_SIDE_CURSORS: set "True" to force client-side cursors globally.
# Recommended on Neon (especially behind a pooler) to avoid dropped named cursors
# during dumpdata / queryset.iterator(). Default False.
DB_DISABLE_SERVER_SIDE_CURSORS=False

# Email (Brevo, Gmail API or SMTP)
# EMAIL_PROVIDER: "brevo", "gmail_api" or "console". Leave empty to keep the
# default: Brevo when BREVO_API_KEY is set, otherwise console (DEBUG) / SMTP.
EMAIL_PROVIDER=
# Gmail API (used when EMAIL_PROVIDER=gmail_api). Sends over HTTPS from the Gmail
# account that authorised the refresh token. Get the token locally with
# scripts/get_gmail_refresh_token.py. GMAIL_SENDER is that Gmail address; it
# becomes DEFAULT_FROM_EMAIL as "Partner Portal <GMAIL_SENDER>". Keep secret.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# DEFAULT_FROM_EMAIL: fallback sender used by notifications/password reset emails.
DEFAULT_FROM_EMAIL="Partner Portal <no-reply@example.com>"
# BREVO_SENDER_EMAIL: REQUIRED if DEFAULT_FROM_EMAIL is not a sender/domain verified
# in Brevo. When set, ALL transactional mail is sent From this address (Brevo
# rejects unverified senders with 400 "sender not valid"). BREVO_SENDER_NAME is optional.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# BREVO_API_KEY: if set, uses BrevoAPIEmailBackend (HTTPS API). Required in production if using Brevo.
BREVO_API_KEY=
# SMTP fallback (used if BREVO_API_KEY not set in non-DEBUG or as configured): EMAIL_BACKEND logic selects SMTP in non-DEBUG by default.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Email rate limiting
NOTIFY_EMAIL_DAILY_LIMIT=200

# Site base URL for notification emails
# SITE_URL: absolute base URL without trailing slash (used in email templates/links). If empty and RENDER_EXTERNAL_HOSTNAME exists, derived as https://<host>.
SITE_URL=

# WhatsApp (disabled by default)
# WHATSAPP_ENABLED: "true" enables channel (exists but disabled by default; sandbox/template constraints apply).
WHATSAPP_ENABLED=False
# WHATSAPP_PROVIDER: "twilio" (default) or "360dialog" (case-insensitive).
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# --- 360dialog (used when WHATSAPP_PROVIDER=360dialog) ---
# D360_API_KEY: provider API key, sent as the D360-API-KEY header. Keep secret.
D360_API_KEY=
# D360_BASE_URL: API base (default https://waba-sandbox.360dialog.io).
D360_BASE_URL=https://waba-sandbox.360dialog.io
# D360_WEBHOOK_TOKEN: shared secret embedded in the inbound webhook URL path.
# Endpoint is POST /webhooks/whatsapp/<D360_WEBHOOK_TOKEN>/. Keep secret.
D360_WEBHOOK_TOKEN=
# WHATSAPP_ALLOWED_NUMBERS: comma-separated numbers allowed to receive messages.
# Entries are normalised to E.164, so 9198502965232 and +9198502965232 are equivalent.
WHATSAPP_ALLOWED_NUMBERS=
# Daily limit for WhatsApp messages (<=0 means unlimited in code path; verify).
NOTIFY_WHATSAPP_DAILY_LIMIT=50

# OCR (disabled by default)
# OCR_ENABLED: "true" enables OCR processing for supported documents.
OCR_ENABLED=False
# OCR_PROVIDER: "ocrspace" (OCR.space API, default), "tesseract" (engine on the
# server, needs the Docker deploy) or "hybrid" (Tesseract, OCR.space fallback).
OCR_PROVIDER=ocrspace
OCRSPACE_API_KEY=
# OCR_DAILY_LIMIT: OCR.space calls per day (default 100; Tesseract is not counted).
# OCR_MAX_BYTES: max bytes per file sent to OCR.space (default 1MB).
OCR_DAILY_LIMIT=100
OCR_MAX_BYTES=1048576
# Tesseract (OCR_PROVIDER=tesseract or hybrid): languages, per-step timeout (s), PDF pages read.
OCR_TESSERACT_LANG=eng+hin
OCR_TESSERACT_TIMEOUT=120
OCR_PDF_MAX_PAGES=5

# Security (production hardening)
# SECURE_HSTS_SECONDS: HSTS max-age when not DEBUG (default 3600).
SECURE_HSTS_SECONDS=3600

# Admin superuser auto-creation on Render (build.sh uses these)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
